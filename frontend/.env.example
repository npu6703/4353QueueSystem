# Frontend env override.
#
# By default, the app talks to the Railway-deployed backend (configured in
# src/config.js). You only need this file if you want to point at a different
# backend — typically your own local one for debugging.
#
# To enable: copy this to `.env.local` (gitignored) and uncomment the line.
# Then restart `npm run dev`.
#
# VITE_API_URL=http://localhost:3001
